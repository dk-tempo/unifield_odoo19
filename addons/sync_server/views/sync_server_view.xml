<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>
    
<!-- =========================TYPE OF GROUP=============================== -->

        <record model="ir.ui.view" id="group_type_tree_view">
            <field name="name">group_type.tree</field>
            <field name="model">sync.server.group_type</field>
            <field name="arch" type="xml">
                <list string="Synchronization Instance Group Type">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="group_type_form_view">
            <field name="name">group_type.form</field>
            <field name="model">sync.server.group_type</field>
            <field name="arch" type="xml">
                <form string="Type of Group">
                    <field name="name"/>
                </form>
            </field>
        </record>

<!-- =========================ENTITY=============================== -->

        <record model="ir.ui.view" id="entity_tree_view">
            <field name="name">entity.tree</field>
            <field name="model">sync.server.entity</field>
            <field name="arch" type="xml">
                <list string="Instance Tree">
                    <field name="name"/>
                    <field name="identifier"/>
                    <field name="parent_id"/>
                    <field name="instance_level"/>
                    <field name="activity" options="{'allow_order': '1'}" /> <!-- TODO allow_sort="1"/> -->
                    <field name="last_dateactivity" options="{'allow_order': '1'}" /> <!-- TODO allow_sort="1"/> -->
                    <field name="date_success_sync" />
                    <field name="country_id" />
                    <field name="mission" />
                    <field name="oc" />
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="entity_form_view">
            <field name="name">entity.form</field>
            <field name="model">sync.server.entity</field>
            <field name="arch" type="xml">
                <form string="Instance Form">
                    <group colspan="2">
                        <button icon="fa-check" string="Validate" name="validate_action" type="object" invisible="state not in ('pending' ,'invalidated', 'updated')"/>
                        <button icon="oi-close" string="Invalidate" name="invalidate_action" type="object" invisible="state != 'validated'"/>
                    </group>
                    <group colspan="2" />
                    <newline/>
                    <group colspan="4" col="6">
                        <group colspan="2" col="2">
                            <separator string="Configuration" colspan="2"/>
                            <field name="name"/>
                            <field name="oc" required="1" readonly="state == 'validated'" />
                            <field name="identifier"/>
                            <field name="hardware_id" />
                            <field name="email"/>
                            <field name="parent_id" domain="[('instance_level', 'in', ['coordo', 'section'])]"/>
                            <field name="user_id"/>
                        </group>
                        <group colspan="2" col="2">
                            <separator string="State" colspan="2"/>
                            <field name="state" readonly="1"/>
                            <field name="activity"/>
                            <field name="last_dateactivity"/>
                            <field name="date_success_sync" />
                            <field name="last_sequence"/>
                        </group>
                        <group colspan="2" col="2">
                            <separator string="Geographical information" colspan="2"/>
                            <field name="country_id" />
                            <field name="city" />
                            <field name="mission" />
                            <field name="latitude" />
                            <field name="longitude" />
                        </group>
                    </group>
                    <separator string="Groups" colspan="4"/>
                    <field name="group_ids" colspan="4" nolabel="1"/>
                    <separator string="Children" colspan="4"/>
                    <field name="children_ids" colspan="4" nolabel="1"/>
                </form>
            </field>
        </record>

