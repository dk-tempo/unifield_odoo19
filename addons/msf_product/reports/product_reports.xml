<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_report_portrait" model="report.paperformat">
            <field name="name">Format A4 Custom Portrait</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">10</field>
            <field name="dpi">90</field>
        </record>

        <record id="paperformat_report_landscape" model="report.paperformat">
            <field name="name">Format A4 Custom Landscape</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">30</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">30</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_tracking_sheet" model="ir.actions.report">
            <field name="name">Product Labels</field>
            <field name="model">product.product</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">msf_product.product_labels_product</field>
            <field name="report_file">msf_product.product_labels_product</field>
            <field name="paperformat_id" ref="msf_product.paperformat_report_portrait"/>
            <field name="print_report_name">'Product Labels'</field>
            <field name="binding_model_id" ref="msf_product.model_product_product"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_product_list_report" model="ir.actions.report">
            <field name="name">Product List / Sub-List</field>
            <field name="model">product.list</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">msf_product.product_list_report</field>
            <field name="report_file">msf_product.product_list_report</field>
            <field name="paperformat_id" ref="msf_product.paperformat_report_landscape"/>
            <field name="print_report_name">'Product List'</field>
            <field name="binding_model_id" ref="msf_product.model_product_list"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>