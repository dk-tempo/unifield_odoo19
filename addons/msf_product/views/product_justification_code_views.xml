<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_justification_code_view_action" model="ir.actions.act_window">
        <field name="name">Justification codes</field>
        <field name="res_model">product.justification.code</field>
        <field name="view_mode">list</field>
    </record>

    <record id="product_justification_code_search_view" model="ir.ui.view">
        <field name="name">product.justification.code.search.view</field>
        <field name="model">product.justification.code</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Justification codes">
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="product_justification_code_list_view" model="ir.ui.view">
        <field name="name">product.justification.code.list.view</field>
        <field name="model">product.justification.code</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Justification codes" editable="top" duplicate="False">
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>
</odoo>
