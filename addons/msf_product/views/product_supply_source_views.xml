<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_supply_source_view_action" model="ir.actions.act_window">
        <field name="name">Supply sources</field>
        <field name="res_model">product.supply.source</field>
        <field name="view_mode">list</field>
    </record>

    <record id="product_supply_source_search_view" model="ir.ui.view">
        <field name="name">product.supply.source.search.view</field>
        <field name="model">product.supply.source</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Supply sources">
                <field name="source"/>
            </search>
        </field>
    </record>

    <record id="product_supply_source_list_view" model="ir.ui.view">
        <field name="name">product.supply.source.list.view</field>
        <field name="model">product.supply.source</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Supply Source" editable="top" duplicate="False">
                <field name="source"/>
            </list>
        </field>
    </record>
</odoo>
