<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue Formulaire -->
    <record id="product_purchase_form_view" model="ir.ui.view">
        <field name="name">product.purchase.form.view</field>
        <field name="model">product.purchase</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="" >
                <sheet>
                    <!-- Main Fields -->
                    <field name="name" />
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="product_id" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Liste -->
    <record id="product_purchase_list_view" model="ir.ui.view">
        <field name="name">product.purchase.list.view</field>
        <field name="model">product.purchase</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="" >
                <!-- Fields -->
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="product_purchase_view_action" model="ir.actions.act_window">
        <field name="name">Product Purchases</field>
        <field name="res_model">product.purchase</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>