<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_international_status_view_action" model="ir.actions.act_window">
        <field name="name">Product creators</field>
        <field name="res_model">product.international.status</field>
        <field name="view_mode">list</field>
    </record>

    <record id="product_international_status_search_view" model="ir.ui.view">
        <field name="name">product.international.status.search</field>
        <field name="model">product.international.status</field>
        <field name="arch" type="xml">
            <search string="Product creators">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="product_international_status_tree_view" model="ir.ui.view">
        <field name="name">product.international.status.list</field>
        <field name="model">product.international.status</field>
        <field name="arch" type="xml">
            <list string="Product Creators" editable="top" duplicate="False">
                <field name="name"/>
                <field name="no_external"/>
                <field name="no_esc"/>
                <field name="no_internal"/>
                <field name="no_consumption"/>
                <field name="no_storage"/>
            </list>
        </field>
    </record>
</odoo>
